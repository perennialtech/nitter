# Environment variables Nitter reads. Use this file with docker run
# --env-file, Compose's env_file or systemd's EnvironmentFile, or set
# the variables in the shell.
#
# Each value shown is the default. An unset or empty variable uses the
# default.
#
# Generated by make generate from internal/config/options.go; change the
# descriptions and defaults there.

# Path of the config file, relative to the working directory. nitter
# healthcheck reads it too, to find the port.
NITTER_CONF_FILE=./nitter.conf

# Path of the account sessions file, with one JSON session per line (see
# the README). It must not end in .json. It isn't read with guestAuth.
NITTER_SESSIONS_FILE=./sessions.jsonl

# Bearer token that guest requests authenticate with, without the
# "Bearer " prefix. Required when guestAuth is on, and ignored
# otherwise. Secret: keep it out of version control, logs and images.
NITTER_GUEST_BEARER_TOKEN=
